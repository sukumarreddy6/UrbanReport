<!doctype html><html lang="<%= language %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= t(title) %> · UrbanReport</title><link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/site.css" rel="stylesheet"><link href="/css/experience.css" rel="stylesheet"><link href="/css/organization.css" rel="stylesheet"></head><body class="simple-auth-body"><header class="simple-auth-header"><a class="brand-mark" href="/"><%- lucide('home') %><span>UrbanReport</span></a><%- include('../partials/language-switch') %><a href="/"><%= t('Back to role portals') %></a></header><main class="simple-auth-main"><div class="auth-card"><div class="auth-card-icon"><%- lucide(portal === 'admin' ? 'shield' : portal === 'department' ? 'building_2' : portal === 'employee' ? 'hard_hat' : 'user_round') %></div><p class="eyebrow"><%= t(portal ? `${portal.toUpperCase()} PORTAL` : 'ACCOUNT ACCESS') %></p><h1><%= t(title) %></h1><p class="form-intro"><%= t(portal === 'user' ? 'Check your reports and see the latest updates.' : portal ? 'Sign in with the account provided by your administrator.' : 'Use your registered email and password.') %></p><%- include('../partials/messages') %><form method="post" action="/login" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="portal" value="<%= portal %>"><label class="form-label"><%= t('Email address') %><input class="form-control mt-1" type="email" name="email" required autocomplete="email" placeholder="you@example.com"></label><label class="form-label"><%= t('Password') %><span class="password-input-wrap"><input id="login-password" class="form-control mt-1" type="password" name="password" required autocomplete="current-password" placeholder="Your password"><button class="password-toggle" type="button" data-password-toggle="login-password" aria-label="Show password" title="Show password"><%- lucide('eye') %></button></span></label><a class="forgot-link" href="/forgot-password"><%= t('Forgot password?') %></a><button class="btn btn-primary w-100 mt-2"><%= t(title) %></button></form><% if (!portal || portal === 'user') { %><div class="auth-note"><%- lucide('help') %><span><%= t('Having trouble signing in? Contact your UrbanReport administrator.') %></span></div><% } %></div><p class="auth-bottom-note"><%= t(portal === 'user' ? 'New to UrbanReport?' : 'Staff accounts are created by an administrator.') %> <% if (!portal || portal === 'user') { %><a href="/register"><%= t('Create account') %></a><% } %></p></main><script src="/js/bootstrap-validation.js" defer></script><script src="/js/password-toggle.js" defer></script></body></html>








