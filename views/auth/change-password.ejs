<%- include('../partials/page-top', { title, activePage }) %>
<div class="page-heading"><div><p class="eyebrow"><%= t('ACCOUNT SECURITY') %></p><h1><%= t('Change password') %></h1><p class="page-subtitle"><%= t('Confirm your current password, then choose a new one.') %></p></div></div>
<section class="content-card profile-card"><form method="post" action="/profile/change-password" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label class="form-label"><%= t('Current password') %><span class="password-input-wrap"><input id="current-password" class="form-control mt-1" type="password" name="currentPassword" required autocomplete="current-password"><button class="password-toggle" type="button" data-password-toggle="current-password" aria-label="Show password"><%- lucide('visibility') %></button></span></label>
  <label class="form-label"><%= t('New password') %><span class="password-input-wrap"><input id="new-password" class="form-control mt-1" type="password" name="newPassword" required minlength="12" maxlength="128" autocomplete="new-password"><button class="password-toggle" type="button" data-password-toggle="new-password" data-password-toggle-also="confirm-new-password" aria-label="Show passwords"><%- lucide('visibility') %></button></span><span class="form-text"><%= t('Use 12 or more characters.') %></span></label>
  <label class="form-label"><%= t('Confirm new password') %><input id="confirm-new-password" class="form-control mt-1" type="password" name="confirmPassword" required minlength="12" maxlength="128" autocomplete="new-password"></label>
  <button class="btn btn-primary align-self-start"><%- lucide('key_round') %> <%= t('Update password') %></button>
</form></section><script src="/js/password-toggle.js" defer></script><%- include('../partials/page-bottom') %>

