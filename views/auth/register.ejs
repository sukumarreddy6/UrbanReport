<!doctype html><html lang="<%= language %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= t('Create account') %> · UrbanReport</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/site.css" rel="stylesheet"><link href="/css/experience.css" rel="stylesheet"><link href="/css/organization.css" rel="stylesheet"></head><body class="simple-auth-body">
<header class="simple-auth-header"><a class="brand-mark" href="/"><%- lucide('location_city') %><span>UrbanReport</span></a><%- include('../partials/language-switch') %><a href="/login?portal=user"><%= t('Already registered?') %> <strong><%= t('Sign in') %></strong></a></header>
<main class="simple-auth-main"><div class="auth-card"><div class="auth-card-icon"><%- lucide('person_add') %></div><p class="eyebrow"><%= t('USER PORTAL') %></p><h1><%= t('Create an account') %></h1><p class="form-intro"><%= t('Create a login to submit reports and follow their progress.') %></p><%- include('../partials/messages') %>
<form method="post" action="/register" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label class="form-label"><%= t('Full name') %><input class="form-control mt-1" name="fullName" required minlength="2" maxlength="100" autocomplete="name" placeholder="<%= t('Your full name') %>"></label>
  <label class="form-label"><%= t('Email address') %><div class="email-verification-row mt-1"><input id="registration-email" class="form-control" type="email" name="email" required autocomplete="email" placeholder="you@example.com"><button id="send-email-code" class="btn btn-outline-dark" type="button"><%= t('Send code') %></button></div></label>
  <p id="otp-status" class="form-text otp-status" role="status" aria-live="polite"><%= t('Verify your email before creating your account.') %></p>
  <label class="form-label"><%= t('Email verification code') %><input class="form-control mt-1" name="otp" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="123456"></label>
  <label class="form-label"><%= t('Password') %><input class="form-control mt-1" type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password" placeholder="<%= t('At least 12 characters') %>"><span class="form-text"><%= t('Use 12 or more characters.') %></span></label>
  <button class="btn btn-primary w-100 mt-2"><%= t('Create account') %></button>
</form>
<div class="auth-note"><%- lucide('lock') %><span><%= t('Your reports are private to you and authorized civic staff.') %></span></div></div><p class="auth-bottom-note"><%= t('UrbanReport is for reporting issues affecting public places and services.') %></p></main>
<script src="/js/bootstrap-validation.js" defer></script><script src="/js/register-otp.js" defer></script></body></html>


