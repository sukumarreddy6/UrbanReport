<!doctype html><html lang="<%= language %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= t(title) %> · UrbanReport</title><link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/site.css" rel="stylesheet"><link href="/css/experience.css" rel="stylesheet"><link href="/css/organization.css" rel="stylesheet"></head><body class="simple-auth-body"><header class="simple-auth-header"><a class="brand-mark" href="/"><%- lucide('home') %><span>UrbanReport</span></a><%- include('../partials/language-switch') %><a href="/login"><%= t('Back to sign in') %></a></header><main class="simple-auth-main"><div class="auth-card"><div class="auth-card-icon"><%- lucide('key_round') %></div><h1><%= t('Reset password') %></h1><p class="form-intro"><%= t('Request an email code, then choose a new password.') %></p><%- include('../partials/messages') %><% if (stage === 'reset') { %><form method="post" action="/forgot-password/reset" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Email address') %><input class="form-control mt-1" name="email" type="email" required value="<%= email %>" autocomplete="email"></label><label class="form-label"><%= t('Email verification code') %><input class="form-control mt-1" name="otp" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6"></label><label class="form-label"><%= t('New password') %><span class="password-input-wrap"><input id="reset-password" class="form-control mt-1" type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password"><button class="password-toggle" type="button" data-password-toggle="reset-password" data-password-toggle-also="confirm-reset-password" aria-label="Show passwords"><%- lucide('eye') %></button></span></label><label class="form-label"><%= t('Confirm new password') %><input id="confirm-reset-password" class="form-control mt-1" type="password" name="confirmPassword" required minlength="12" maxlength="128" autocomplete="new-password"></label><button class="btn btn-primary w-100"><%= t('Update password') %></button></form><form method="post" action="/forgot-password/send-code" class="mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="email" value="<%= email %>"><button class="btn btn-link p-0"><%= t('Send a new code') %></button></form><% } else { %><form method="post" action="/forgot-password/send-code" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Email address') %><input class="form-control mt-1" name="email" type="email" required autocomplete="email" placeholder="you@example.com"></label><button class="btn btn-primary w-100"><%= t('Send reset code') %></button></form><% } %></div></main><script src="/js/bootstrap-validation.js" defer></script><script src="/js/password-toggle.js" defer></script></body></html>






