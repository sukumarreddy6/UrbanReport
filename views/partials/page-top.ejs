<!doctype html>
<html lang="<%= language %>"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t(title) %> · UrbanReport</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/site.css" rel="stylesheet"><link href="/css/experience.css" rel="stylesheet"><link href="/css/organization.css?v=staff-sidebar-black-20261116" rel="stylesheet">
  <% if (activePage === 'report') { %><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""><% } %>
</head><body class="portal-body page-<%= currentUser.role %>-<%= activePage || 'default' %>">
    <header class="portal-topbar">
      <form class="topbar-brand-form" method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="topbar-brand" type="submit" aria-label="<%= t('Sign out and return home') %>" title="<%= t('Sign out and return home') %>"><%- lucide('location_city') %><span>UrbanReport</span></button></form>
      <div class="topbar-actions"><%- include('language-switch') %><a class="icon-button notification-button" href="/notifications" aria-label="<%= t('Notifications') %>" title="<%= t('Notifications') %>"><%- lucide('notifications') %><% if (unreadCount) { %><span class="notification-count"><%= unreadCount > 9 ? '9+' : unreadCount %></span><% } %></a><details class="topbar-profile-menu"><summary class="topbar-profile-link" aria-label="<%= t('My profile') %>" title="<%= t('My profile') %>"><span class="profile-initial"><%= currentUser.fullName.trim().charAt(0).toUpperCase() %></span></summary><div class="profile-popover"><div class="profile-popover-user"><strong><%= currentUser.fullName %></strong><span><%= currentUser.email %></span></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="profile-popover-logout" type="submit"><%- lucide('logout') %><%= t('Sign out') %></button></form></div></details></div>
    </header>
<div class="portal-frame">
  <aside class="portal-sidebar">
    <div class="sidebar-label"><%= t('WORKSPACE') %></div>
    <% const links = currentUser.role === 'admin' ? [
      ['dashboard','/admin/dashboard','space_dashboard','Admin overview'],['complaints','/admin/complaints','fact_check','Admin reports'],['departments','/admin/departments','account_tree','Admin departments']
    ] : currentUser.role === 'department' ? [
      ['dashboard','/department/dashboard','space_dashboard','Department overview'],['complaints','/department/complaints','fact_check','Department reports'],['employees','/department/employees','groups','Department employees']
    ] : currentUser.role === 'employee' ? [
      ['dashboard','/employee/dashboard','space_dashboard','Employee overview'],['complaints','/employee/complaints','assignment','Employee reports']
    ] : [
      ['dashboard','/citizen/dashboard','space_dashboard','Citizen overview'],['complaints','/citizen/complaints','inventory_2','Citizen reports'],['report','/citizen/complaints/new','add_location_alt','Report an issue'],['password','/profile/change-password','key_round','Change password']
    ]; %>
    <nav class="sidebar-nav" aria-label="<%= t('Workspace navigation') %>">
      <% links.forEach(link => { %><a class="sidebar-link <%= activePage === link[0] ? 'active' : '' %>" href="<%= link[1] %>" aria-label="<%= t(link[3]) %>" title="<%= t(link[3]) %>"><%- lucide(link[2]) %><span><%= t(link[3]) %></span></a><% }); %>
    </nav>
  </aside>
  <div class="portal-workspace">
    <main class="portal-main"><%- include('messages') %>



