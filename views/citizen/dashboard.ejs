<%- include('../partials/page-top') %>
<div class="page-heading dashboard-heading">
  <div><h1><%= t('Good day') %>, <%= currentUser.fullName.split(' ')[0] %></h1></div>
</div>

<section class="metric-grid citizen-metrics" aria-label="<%= t('Your complaint statistics') %>">
  <%- include('../partials/metric-card',{label:'TOTAL REPORTS',value:total,icon:'inbox',tone:'navy',foot:'Submitted by you'}) %>
  <%- include('../partials/metric-card',{label:'UNDER REVIEW',value:counts['Under Review']||0,icon:'clock_3',tone:'orange',foot:'Needs attention'}) %>
  <%- include('../partials/metric-card',{label:'IN PROGRESS',value:counts['In Progress']||0,icon:'wrench',tone:'blue',foot:'Work underway'}) %>
  <%- include('../partials/metric-card',{label:'RESOLVED',value:counts.Resolved||0,icon:'circle_check',tone:'green',foot:'Completed'}) %>
</section>

<% if (pendingConfirmations.length) { %>
<section class="content-card">
  <div class="section-heading"><div><h2><%= t('Confirm completed work') %></h2><p><%= t('Review the employee update and enter the code sent to your email to resolve a report.') %></p></div></div>
  <div class="row g-3">
    <% pendingConfirmations.forEach(item => { %>
      <div class="col-12"><article class="confirmation-card">
        <div class="section-heading mb-3"><div><h3 class="h5 mb-1"><a class="table-title" href="/citizen/complaints/<%= item._id %>"><%= item.title %></a></h3><p class="mb-0"><%= item.location.address %></p></div><%- include('../partials/status',{status:item.status}) %></div>
        <p><%= item.pendingResolutionRemarks %></p>
        <% if (item.resolutionImages.length) { %><div class="image-grid mb-3"><% item.resolutionImages.forEach((image,index) => { %><a href="/citizen/complaints/<%= item._id %>" aria-label="<%= t('View proof of work') %> <%= index + 1 %>"><img src="<%= image.displayUrl %>" alt="<%= t('Employee proof of completed work') %> <%= index + 1 %>"></a><% }); %></div><% } %>
        <div class="d-flex flex-wrap align-items-end gap-2"><form method="post" action="/citizen/complaints/<%= item._id %>/confirm-resolution?next=dashboard" class="d-flex flex-wrap align-items-end gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label mb-0"><%= t('Email confirmation code') %><input class="form-control mt-1" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required></label><button class="btn btn-primary"><%- lucide('check_circle') %><%= t('Confirm resolution') %></button></form><form method="post" action="/citizen/complaints/<%= item._id %>/resolution-code?next=dashboard"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary" type="submit"><%- lucide('refresh_cw') %><%= t('Send a new code') %></button></form></div>
      </article></div>
    <% }); %>
  </div>
</section>
<% } %>

<section class="content-card">
  <div class="section-heading"><div><h2><%= t('Recent reports') %></h2><p><%= t('Your latest neighborhood updates') %></p></div><a class="text-link" href="/citizen/complaints"><%= t('View all') %><%- lucide('arrow_forward') %></a></div>
  <% if (recent.length) { %><div class="table-responsive"><table class="table app-table"><thead><tr><th><%= t('REPORT') %></th><th><%= t('CATEGORY') %></th><th><%= t('STATUS') %></th><th><%= t('SUBMITTED') %></th><th></th></tr></thead><tbody><% recent.forEach(item => { %><tr><td><a class="table-title" href="/citizen/complaints/<%= item._id %>"><%= item.title %></a><small><%= item.location.address %></small></td><td><%= t(item.category) %></td><td><%- include('../partials/status',{status:item.status}) %></td><td><%= item.createdAt.toLocaleDateString(language) %></td><td><a class="report-view-button" href="/citizen/complaints/<%= item._id %>" aria-label="<%= t('View report') %>"><%- lucide('visibility') %><span><%= t('View') %></span></a></td></tr><% }); %></tbody></table></div><% } else { %><%- include('../partials/empty',{icon:'add_location_alt',title:'No reports yet',description:'When you report a civic issue, you can track every update here.',href:'/citizen/complaints/new',action:'Create your first report'}) %><% } %>
</section>
<%- include('../partials/page-bottom') %>
