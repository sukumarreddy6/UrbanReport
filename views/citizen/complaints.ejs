<%- include('../partials/page-top') %><div class="page-heading reports-heading"><h1><%= t("My reports") %></h1></div>
<section class="content-card"><form class="filter-bar" method="get"><select class="form-select" name="status"><option value=""><%= t("All statuses") %></option><% statuses.forEach(s => { %><option value="<%= s %>" <%= s === filters.status ? 'selected' : '' %>><%= t(s) %></option><% }); %></select><select class="form-select" name="category"><option value=""><%= t("All categories") %></option><% categories.forEach(c => { %><option value="<%= c %>" <%= c === filters.category ? 'selected' : '' %>><%= t(c) %></option><% }); %></select><% if (filters.status || filters.category) { %><a class="btn btn-outline-secondary clear-filters" href="/citizen/complaints"><%- lucide('close') %><%= t("Clear filters") %></a><% } else { %><button class="btn btn-outline-secondary"><%= t("Filter") %></button><% } %></form>
<% if (complaints.length) { %><div class="table-responsive"><table class="table app-table"><thead><tr><th><%= t("REPORT") %></th><th><%= t("CATEGORY") %></th><th><%= t("STATUS") %></th><th><%= t("UPDATED") %></th><th></th></tr></thead><tbody><% complaints.forEach(item => { %><tr><td><a class="table-title" href="/citizen/complaints/<%= item._id %>"><%= item.title %></a><small><%= item.location.address %></small></td><td><%= t(item.category) %></td><td><%- include('../partials/status',{status:item.status}) %></td><td><%= item.updatedAt.toLocaleDateString(language) %></td><td><div class="report-row-actions report-row-view-only"><a class="report-view-button" href="/citizen/complaints/<%= item._id %>" aria-label="<%= t('View report') %>"><%- lucide('visibility') %><span><%= t('View') %></span></a></div></td></tr><% }); %></tbody></table></div><% } else { %><%- include('../partials/empty',{icon:'search_off',title:'No matching reports',description:'Try changing the filters, or submit a new report.',...(!filters.status && !filters.category ? {href:'/citizen/complaints/new',action:'Report an issue'} : {})}) %><% } %>
<% if (pages > 1) { %><nav class="pagination-row"><span><%= t("Page") %> <%= page %> of <%= pages %></span><div><% if (page > 1) { %><a class="btn btn-sm btn-light" href="?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page-1 %>"><%= t("Previous") %></a><% } %> <% if (page < pages) { %><a class="btn btn-sm btn-light" href="?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page+1 %>"><%= t("Next") %></a><% } %></div></nav><% } %></section><%- include('../partials/page-bottom') %>




