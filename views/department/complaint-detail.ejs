<%- include('../partials/page-top') %>
<div class="page-heading"><div><a class="back-link" href="/department/complaints"><%- lucide('arrow_back') %><%= t('Department reports') %></a><p class="eyebrow mt-3"><%= t('REPORT') %> · <%= String(complaint._id).slice(-8).toUpperCase() %></p><h1><%= complaint.title %></h1><p class="page-subtitle"><%= t(complaint.category) %> · <%= complaint.location.address %></p></div><%- include('../partials/status',{status:complaint.status}) %></div>
<div class="detail-grid"><div class="detail-main"><section class="content-card"><div class="section-heading"><div><h2><%= t('Resident report') %></h2><p><%= t('Submitted by') %> <%= complaint.citizenId?.fullName %> · <%= complaint.createdAt.toLocaleString() %></p></div><span class="priority priority-<%= complaint.priority.toLowerCase() %>"><%= t(complaint.priority) %></span></div><p class="detail-description"><%= complaint.description %></p><% if (complaint.images.length) { %><div class="image-grid"><% complaint.images.forEach(image => { %><a href="<%= image.displayUrl %>" target="_blank" rel="noopener"><img src="<%= image.displayUrl %>" alt="<%= t('Report evidence') %>"></a><% }); %></div><% } %><% if (complaint.resolutionImages?.length) { %><div class="mt-4"><h3 class="h6"><%= t('Employee proof of work') %></h3><div class="image-grid"><% complaint.resolutionImages.forEach((image, index) => { %><a href="<%= image.displayUrl %>" target="_blank" rel="noopener"><img src="<%= image.displayUrl %>" alt="<%= t('Employee proof of completed work') %> <%= index + 1 %>"></a><% }); %></div></div><% } %></section>
<section class="content-card"><div class="section-heading"><div><h2><%= complaint.assignedEmployeeId ? t('Edit employee assignment') : t('Assign to employee') %></h2><p><%= complaint.assignedEmployeeId && complaint.status === 'In Progress' ? t('This employee has accepted the work. They must withdraw before you can reassign it.') : complaint.assignedEmployeeId ? t('Change or remove the assignment until the employee starts work.') : t('Choose an active employee from your department.') %></p></div></div><% if (['Approved','Assigned','In Progress','Reopened'].includes(complaint.status) && !(complaint.assignedEmployeeId && complaint.status === 'In Progress')) { %><% if (employees.some(employee => !complaint.assignedEmployeeId || String(complaint.assignedEmployeeId._id) !== String(employee._id))) { %><form method="post" action="/department/complaints/<%= complaint._id %>/assignment" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-8"><label class="form-label"><%= t('Employee') %><select class="form-select mt-1" name="employeeId" required><option value=""><%= complaint.assignedEmployeeId ? t('Choose a different employee') : t('Choose employee') %></option><% employees.filter(employee => !complaint.assignedEmployeeId || String(complaint.assignedEmployeeId._id) !== String(employee._id)).forEach(employee => { %><option value="<%= employee._id %>"><%= employee.fullName %></option><% }); %></select></label></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100"><%= complaint.assignedEmployeeId ? t('Update employee') : t('Assign employee') %></button></div></form><% } else { %><div class="notice-panel"><%- lucide('info') %><p><%= t('No other active employee is available to change this assignment.') %> <a href="/department/employees"><%= t('Manage employees') %></a></p></div><% } %><% if (complaint.assignedEmployeeId && complaint.status === 'Assigned') { %><form method="post" action="/department/complaints/<%= complaint._id %>/assignment/remove" class="mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger" type="submit"><%- lucide('person_remove') %><%= t('Remove employee assignment') %></button></form><% } %><% } else if (complaint.assignedEmployeeId && complaint.status === 'In Progress') { %><div class="notice-panel"><%- lucide('info') %><p><%= t('The assigned employee has accepted this work. Reassignment becomes available if the employee withdraws.') %></p></div><% } else { %><p class="text-muted"><%= t('This report is not ready for employee assignment.') %></p><% } %></section>
<section class="content-card"><div class="section-heading"><div><h2><%= t('Activity timeline') %></h2><p><%= t('Report history and assignment updates.') %></p></div></div><div class="timeline"><% events.forEach(event => { %><div class="timeline-item"><span class="timeline-icon"><%- lucide(event.type === 'status' ? 'sync_alt' : event.type === 'assignment' ? 'assignment_ind' : event.type === 'priority' ? 'priority_high' : 'add_location_alt') %></span><div><div class="timeline-title"><%= t(event.newStatus || event.type) %></div><p><%= event.remarks %></p><small><%= event.actorId?.fullName || t('System') %> · <%= event.createdAt.toLocaleString() %></small></div></div><% }); %></div></section></div>
<aside class="detail-aside"><section class="content-card"><h2 class="h6"><%= t('At a glance') %></h2><div class="meta-list"><div><small><%= t('STATUS') %></small><%- include('../partials/status',{status:complaint.status}) %></div><div><small><%= t('RESIDENT') %></small><strong><%= complaint.citizenId?.fullName %></strong></div><div><small><%= t('ASSIGNED TO') %></small><strong><%= complaint.assignedEmployeeId?.fullName || t('Awaiting assignment') %></strong></div><div><small><%= t('PRIORITY') %></small><strong><%= t(complaint.priority) %></strong></div></div></section><section class="content-card"><h2 class="h6"><%= t('Resident messages') %></h2><% if (messages.length) { messages.forEach(message => { %><div class="message-item"><strong><%= message.authorId?.fullName %></strong><small><%= message.createdAt.toLocaleString() %></small><p><%= message.body %></p></div><% }); } else { %><p class="text-muted"><%= t('No follow-up messages.') %></p><% } %></section></aside></div>
<%- include('../partials/page-bottom') %>
