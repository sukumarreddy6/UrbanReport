<%- include('../partials/page-top') %>
<div class="page-heading"><div><p class="eyebrow"><%= t('DEPARTMENT WORKSPACE') %></p><h1><%= t('Department employees') %></h1><p class="page-subtitle"><%= t('Manage the employee accounts for') %> <%= department.name %>.</p></div></div>
<div class="two-column-grid management-grid"><section class="content-card"><div class="section-heading"><div><h2><%= t('Employees') %></h2><p><%= employees.length %> <%= t('accounts') %></p></div></div>
<% if (employees.length) { %><div class="management-list"><% employees.forEach(employee => { const memberDepartments = (employee.departmentIds || []).map(d => d?.name).filter(Boolean); if (!memberDepartments.length && employee.departmentId?.name) memberDepartments.push(employee.departmentId.name); %><div class="management-row"><span class="avatar-pill avatar-large"><%= employee.fullName.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></span><div class="management-info"><strong><%= employee.fullName %></strong><small><%= employee.email %></small><small><%= t('Member of') %>: <%= memberDepartments.join(', ') || department.name %></small></div><span class="status-pill <%= employee.isActive ? 'status-resolved' : 'status-rejected' %>"><span class="status-dot"></span><%= employee.isActive ? t('Active') : t('Inactive') %></span><form method="post" action="/department/employees/<%= employee._id %>/membership/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger"><%= t('Remove from department') %></button></form></div><% }); %></div><% } else { %><%- include('../partials/empty',{icon:'groups',title:'No employees yet',description:'Create an employee account so the department can assign reports.'}) %><% } %>
</section><div class="vstack gap-3"><section class="content-card"><div class="section-heading"><div><h2><%= t('Add an employee') %></h2><p><%= t('New employees will belong to') %> <%= department.name %>.</p></div></div><form method="post" action="/department/employees" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="departmentId" value="<%= department._id %>"><label class="form-label"><%= t('Full name') %><input class="form-control mt-1" name="fullName" required minlength="2" maxlength="100"></label><label class="form-label"><%= t('Email address') %><input class="form-control mt-1" type="email" name="email" required></label><label class="form-label"><%= t('Temporary password') %><input class="form-control mt-1" type="password" name="password" required minlength="12" autocomplete="new-password"><span class="form-text"><%= t('Use 12 or more characters.') %></span></label><button class="btn btn-primary align-self-start"><%- lucide('person_add') %><%= t('Create employee') %></button></form></section><section class="content-card"><div class="section-heading"><div><h2><%= t('Add existing employee') %></h2><p><%= t('Employees can be members of more than one department and keep one login.') %></p></div></div><form method="post" action="/department/employees/membership" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Employee account email') %><input class="form-control mt-1" type="email" name="email" required autocomplete="email"></label><button class="btn btn-outline-primary align-self-start"><%- lucide('person_add') %><%= t('Add department access') %></button></form></section></div></div>
<%- include('../partials/page-bottom') %>
