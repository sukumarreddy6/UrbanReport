<%- include('../partials/page-top') %>
<div class="page-heading"><div><p class="eyebrow"><%= t('DEPARTMENT') %></p><h1><%= t('Department reports') %></h1><p class="page-subtitle"><%= t('Review reports routed to your department and assign them to employees.') %></p></div></div>
<section class="content-card"><form class="filter-bar" method="get"><select class="form-select" name="status"><option value=""><%= t('All statuses') %></option><% statuses.forEach(status => { %><option value="<%= status.value %>" <%= selectedStatus === status.value ? 'selected' : '' %>><%= t(status.label) %></option><% }); %></select><button class="btn btn-outline-dark"><%= t('Apply filters') %></button></form>
  <% if (complaints.length) { %><div class="table-responsive"><table class="table app-table"><thead><tr><th><%= t('COMPLAINT') %></th><th><%= t('RESIDENT') %></th><th><%= t('ASSIGNED TO') %></th><th><%= t('STATUS') %></th><th><%= t('PRIORITY') %></th><th><%= t('UPDATED') %></th><th></th></tr></thead><tbody><% complaints.forEach(c => { %><tr><td><a class="table-title" href="/department/complaints/<%= c._id %>"><%= c.title %></a><small><%= t(c.category) %> · <%= c.location.address %></small></td><td><%= c.citizenId?.fullName || t('Resident') %></td><td><%= c.assignedEmployeeId?.fullName || t('Awaiting assignment') %></td><td><%- include('../partials/status',{status:c.status}) %></td><td><span class="priority priority-<%= c.priority.toLowerCase() %>"><%= t(c.priority) %></span></td><td><%= c.updatedAt.toLocaleDateString(language) %></td><td><a class="report-view-button" href="/department/complaints/<%= c._id %>" aria-label="<%= t('View complaint') %>"><%- lucide('visibility') %><span><%= t('View') %></span></a></td></tr><% }); %></tbody></table></div><div class="pagination-row"><span><%= page %> / <%= pages %></span><div><% if (page > 1) { %><a class="btn btn-sm btn-light" href="?page=<%= page - 1 %><%= selectedStatus ? `&status=${encodeURIComponent(selectedStatus)}` : '' %>"><%= t('Previous') %></a><% } %> <% if (page < pages) { %><a class="btn btn-sm btn-light" href="?page=<%= page + 1 %><%= selectedStatus ? `&status=${encodeURIComponent(selectedStatus)}` : '' %>"><%= t('Next') %></a><% } %></div></div><% } else { %><%- include('../partials/empty',{icon:'inbox',title:'No reports match this view',description:'Try another status filter or check back when reports are routed to your department.'}) %><% } %>
</section><%- include('../partials/page-bottom') %>
