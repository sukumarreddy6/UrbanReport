<%- include('../partials/page-top') %>
<div class="page-heading dashboard-heading"><div><p class="eyebrow"><%= t('Department workspace') %></p><h1><%= department.name %></h1><p class="page-subtitle"><%= t('Department overview and employee performance.') %></p></div><a class="btn btn-primary" href="/department/complaints"><%- lucide('fact_check') %><%= t('View department reports') %></a></div>
<section class="metric-grid" aria-label="<%= t('Department statistics') %>">
  <%- include('../partials/metric-card',{label:'TOTAL COMPLAINTS',value:total,icon:'inbox',tone:'navy',foot:'All reports assigned to this department'}) %>
  <%- include('../partials/metric-card',{label:'AWAITING EMPLOYEE',value:awaitingEmployee,icon:'clock_3',tone:'orange',foot:'Not yet assigned to an employee'}) %>
  <%- include('../partials/metric-card',{label:'MEN AT WORK',value:(counts.Assigned||0)+(counts['In Progress']||0),icon:'wrench',tone:'blue',foot:'Assigned or actively being handled'}) %>
  <%- include('../partials/metric-card',{label:'RESOLVED',value:counts.Resolved||0,icon:'circle_check',tone:'green',foot:'Work completed and confirmed'}) %>
</section>
<section class="content-card"><div class="section-heading"><div><h2><%= t('Recent department reports') %></h2><p><%= t('Reports routed to') %> <%= department.name %></p></div><a class="text-link" href="/department/employees"><%= t('Manage employees') %><%- lucide('arrow_forward') %></a></div>
  <% if (recent.length) { %><div class="table-responsive"><table class="table app-table"><thead><tr><th><%= t('COMPLAINT') %></th><th><%= t('RESIDENT') %></th><th><%= t('ASSIGNED TO') %></th><th><%= t('STATUS') %></th><th><%= t('UPDATED') %></th><th></th></tr></thead><tbody><% recent.forEach(c => { %><tr><td><a class="table-title" href="/department/complaints/<%= c._id %>"><%= c.title %></a><small><%= t(c.category) %> · <%= c.location.address %></small></td><td><%= c.citizenId?.fullName || t('Resident') %></td><td><%= c.assignedEmployeeId?.fullName || t('Awaiting assignment') %></td><td><%- include('../partials/status',{status:c.status}) %></td><td><%= c.updatedAt.toLocaleDateString(language) %></td><td><a class="report-view-button" href="/department/complaints/<%= c._id %>"><%- lucide('visibility') %><span><%= t('View') %></span></a></td></tr><% }); %></tbody></table></div><% } else { %><%- include('../partials/empty',{icon:'inbox',title:'No department reports yet',description:'When an administrator routes a report here, it will appear in this list.'}) %><% } %>
</section>
<section class="content-card"><div class="section-heading"><div><h2><%= t('Employee performance') %></h2><p><%= t('Assigned workload and resolutions by employee.') %></p></div><a class="text-link" href="/department/employees"><%= t('Manage employees') %><%- lucide('arrow_forward') %></a></div>
  <% if (performance.length) { %><div class="table-responsive"><table class="table app-table"><thead><tr><th><%= t('EMPLOYEE') %></th><th><%= t('TOTAL ASSIGNMENTS') %></th><th><%= t('ACTIVE') %></th><th><%= t('RESOLVED') %></th></tr></thead><tbody><% performance.forEach(person => { %><tr><td><strong><%= person.fullName %></strong></td><td><%= person.total %></td><td><%= person.active %></td><td><span class="status-pill status-resolved"><%= person.resolved %> <%= t('resolved') %></span></td></tr><% }); %></tbody></table></div><% } else { %><%- include('../partials/empty',{icon:'groups',title:'No employee performance yet',description:'Assign reports to employees to see workload and resolution totals.'}) %><% } %>
</section>
<%- include('../partials/page-bottom') %>
