<%- include('../partials/page-top') %><div class="page-heading"><div><p class="eyebrow">TEAM MANAGEMENT</p><h1><%= t("Team members") %></h1><p class="page-subtitle"><%= t("Create employee logins and manage their department access.") %></p></div></div><div class="two-column-grid management-grid"><section class="content-card"><div class="section-heading"><div><h2><%= t("Employees") %></h2><p><%= employees.length %> accounts</p></div></div><% if (employees.length) { %><div class="management-list"><% employees.forEach(e => { %><div class="management-row"><span class="avatar-pill avatar-large"><%= e.fullName.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></span><div class="management-info"><strong><%= e.fullName %></strong><small><%= e.email %> · <%= e.departmentId?.name || 'No department' %></small></div><span class="status-pill <%= e.isActive ? 'status-resolved' : 'status-rejected' %>"><span class="status-dot"></span><%= e.isActive ? 'Active' : 'Inactive' %></span><form method="post" action="/admin/employees/<%= e._id %>/toggle?_method=PATCH"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-light"><%= e.isActive ? 'Deactivate' : 'Activate' %></button></form></div><% }); %></div><% } else { %><%- include('../partials/empty',{icon:'groups',title:'No team members yet',description:'Create the first employee account for your departments.'}) %><% } %></section><section class="content-card"><div class="section-heading"><div><h2><%= t("Add an employee") %></h2><p><%= t("Employees are assigned reports by an administrator.") %></p></div></div><% if (departments.length) { %><form method="post" action="/admin/employees" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t("Full name") %><input class="form-control mt-1" name="fullName" required minlength="2" maxlength="100"></label><label class="form-label">Email<input class="form-control mt-1" name="email" type="email" required></label><label class="form-label">Temporary password<input class="form-control mt-1" name="password" type="password" required minlength="12" autocomplete="new-password"><span class="form-text">At least 12 characters. Share it securely.</span></label><label class="form-label"><%= t("Department") %><select class="form-select mt-1" name="departmentId" required><option value=""><%= t("Choose department") %></option><% departments.forEach(d => { %><option value="<%= d._id %>"><%= d.name %></option><% }); %></select></label><button class="btn btn-primary align-self-start"><%- lucide('person_add') %> <%= t("Create employee") %></button></form><% } else { %><div class="notice-panel"><%- lucide('info') %><p><%= t("Create an active department before adding employees.") %></p><a href="/admin/departments"><%= t("Manage departments") %></a></div><% } %></section></div><%- include('../partials/page-bottom') %>




