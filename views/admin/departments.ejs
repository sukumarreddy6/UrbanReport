<%- include('../partials/page-top') %>
<div class="page-heading"><div><p class="eyebrow"><%= t('SYSTEM MANAGEMENT') %></p><h1><%= t('Departments') %></h1><p class="page-subtitle"><%= t('Create service departments and provision their sign-in accounts.') %></p></div></div>

<div class="two-column-grid management-grid">
  <section class="content-card"><div class="section-heading"><div><h2><%= t('Service departments') %></h2><p><%= departments.length %> <%= t('departments configured') %></p></div></div>
    <% if (departments.length) { %><div class="management-list"><% departments.forEach(d => { %><div class="management-row"><span class="management-icon"><%- lucide('account_tree') %></span><div class="management-info"><strong><%= d.name %></strong><small><%= d.description || t('No description added') %></small></div><span class="status-pill <%= d.isActive ? 'status-resolved' : 'status-rejected' %>"><span class="status-dot"></span><%= d.isActive ? t('Active') : t('Inactive') %></span><form method="post" action="/admin/departments/<%= d._id %>/toggle?_method=PATCH"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-light"><%= d.isActive ? t('Deactivate') : t('Activate') %></button></form></div><% }); %></div><% } else { %><%- include('../partials/empty',{icon:'account_tree',title:'No departments yet',description:'Create a department to start assigning work.'}) %><% } %>
  </section>
  <section class="content-card"><div class="section-heading"><div><h2><%= t('Add a department') %></h2><p><%= t('Department teams are organized by complaint category.') %></p></div></div><form method="post" action="/admin/departments" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Department category') %><select class="form-select mt-1" name="name" required><option value=""><%= t('Choose category') %></option><% categories.forEach(category => { %><option value="<%= category %>"><%= t(category) %></option><% }); %></select></label><label class="form-label"><%= t('Description') %> <span class="text-muted">(<%= t('optional') %>)</span><textarea class="form-control mt-1" name="description" rows="4" maxlength="500" placeholder="<%= t('What issues does this team handle?') %>"></textarea></label><button class="btn btn-primary align-self-start"><%- lucide('add') %><%= t('Add department') %></button></form></section>
</div>

<div class="two-column-grid management-grid mt-1">
  <section class="content-card"><div class="section-heading"><div><h2><%= t('Department sign-in accounts') %></h2><p><%= t('Each department has a dedicated workspace.') %></p></div><span class="queue-count"><%= departmentUsers.length %></span></div>
    <% if (departmentUsers.length) { %><div class="management-list"><% departmentUsers.forEach(account => { %><div class="management-row"><span class="avatar-pill avatar-large"><%= account.fullName.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></span><div class="management-info"><strong><%= account.fullName %></strong><small><%= account.email %> · <%= account.departmentId?.name || t('No department') %></small></div><span class="status-pill <%= account.isActive ? 'status-resolved' : 'status-rejected' %>"><span class="status-dot"></span><%= account.isActive ? t('Active') : t('Inactive') %></span><form method="post" action="/admin/departments/accounts/<%= account._id %>/toggle?_method=PATCH"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-light"><%= account.isActive ? t('Deactivate') : t('Activate') %></button></form></div><% }); %></div><% } else { %><%- include('../partials/empty',{icon:'account_tree',title:'No department accounts yet',description:'Create a department account so staff can assign and monitor work.'}) %><% } %>
  </section>
  <section class="content-card"><div class="section-heading"><div><h2><%= t('Create a department account') %></h2><p><%= t('This account manages reports and employees in one department.') %></p></div></div>
    <% if (activeDepartments.length) { %><form method="post" action="/admin/departments/accounts" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Full name') %><input class="form-control mt-1" name="fullName" required minlength="2" maxlength="100"></label><label class="form-label"><%= t('Email address') %><input class="form-control mt-1" type="email" name="email" required></label><label class="form-label"><%= t('Temporary password') %><input class="form-control mt-1" type="password" name="password" required minlength="12" autocomplete="new-password"><span class="form-text"><%= t('Use 12 or more characters.') %></span></label><label class="form-label"><%= t('Department') %><select class="form-select mt-1" name="departmentId" required><option value=""><%= t('Choose department') %></option><% activeDepartments.forEach(d => { %><option value="<%= d._id %>"><%= d.name %></option><% }); %></select></label><button class="btn btn-primary align-self-start"><%- lucide('person_add') %><%= t('Create department account') %></button></form><% } else { %><div class="notice-panel"><%- lucide('info') %><p><%= t('Create an active department before provisioning its sign-in account.') %></p></div><% } %>
  </section>
</div>
<%- include('../partials/page-bottom') %>
