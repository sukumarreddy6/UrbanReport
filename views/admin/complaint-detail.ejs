<%- include('../partials/page-top') %><div class="page-heading"><div><a class="back-link" href="/admin/complaints"><%- lucide('arrow_back') %> <%= t("Complaint queue") %></a><p class="eyebrow mt-3">REPORT · <%= String(complaint._id).slice(-8).toUpperCase() %></p><h1><%= complaint.title %></h1><p class="page-subtitle"><%= complaint.category %> · <%= complaint.location.address %></p></div><%- include('../partials/status',{status:complaint.status}) %></div>
<div class="detail-grid"><div class="detail-main"><section class="content-card"><div class="section-heading"><div><h2><%= t("Resident report") %></h2><p><%= t("Submitted by") %> <%= complaint.citizenId?.fullName %> · <%= complaint.createdAt.toLocaleString() %></p></div><span class="priority priority-<%= complaint.priority.toLowerCase() %>"><%= complaint.priority %></span></div><p class="detail-description"><%= complaint.description %></p><% if (complaint.images.length) { %><div class="image-grid"><% complaint.images.forEach(image => { %><a href="<%= image.displayUrl %>" target="_blank" rel="noopener"><img src="<%= image.displayUrl %>" alt="Complaint evidence"></a><% }); %></div><% } %><% if (complaint.resolutionImages?.length) { %><div class="mt-4"><h3 class="h6"><%= t('Employee proof of work') %></h3><div class="image-grid"><% complaint.resolutionImages.forEach((image, index) => { %><a href="<%= image.displayUrl %>" target="_blank" rel="noopener"><img src="<%= image.displayUrl %>" alt="<%= t('Employee proof of completed work') %> <%= index + 1 %>"></a><% }); %></div></div><% } %></section>
<% const awaitingAdminDecision = ['Submitted','Under Review'].includes(complaint.status); const canForwardComplaint = ['Submitted','Under Review','Approved','Assigned','In Progress','Reopened'].includes(complaint.status); %>
<section class="content-card"><div class="section-heading"><div><h2><%= t('Admin decision') %></h2><p><%= t('Reject this report or forward it directly to the responsible department.') %></p></div></div>
<% if (awaitingAdminDecision && !complaint.departmentId) { %><div class="admin-routing-actions"><form method="post" action="/admin/complaints/<%= complaint._id %>/assignment" class="review-action-form admin-forward-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Department') %><select class="form-select mt-1" name="departmentId" required><option value=""><%= t(complaint.departmentId ? 'Choose a different department' : 'Choose a department') %></option><% departments.filter(d => !complaint.departmentId || String(d._id) !== String(complaint.departmentId._id)).forEach(d => { %><option value="<%= d._id %>"><%= d.name %></option><% }); %></select></label><button class="btn btn-primary" type="submit" <%= departments.length ? "" : "disabled" %>><%- lucide('send') %><%= t('Forward to department') %></button><% if (!departments.length) { %><p class="text-muted mb-0"><%= t('No active departments are available to receive reports.') %></p><% } %></form><form method="post" action="/admin/complaints/<%= complaint._id %>/review" class="review-action-form review-action-reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="decision" value="reject"><label class="form-label"><%= t('Reason for rejection') %><textarea class="form-control mt-1" name="remarks" rows="3" maxlength="2000" required placeholder="<%= t('Explain why this report cannot be accepted') %>"></textarea></label><button class="btn btn-outline-danger" type="submit"><%- lucide('close') %><%= t('Reject complaint') %></button></form></div>
<% } else if (complaint.departmentId && !complaint.assignedEmployeeId && ['Submitted','Under Review','More Info Requested','Approved','Assigned','In Progress','Reopened'].includes(complaint.status)) { %>
<div class="notice-panel admin-forwarded-note mb-3"><%- lucide('account_tree') %><p><strong><%= t('Currently routed to') %> <%= complaint.departmentId.name %>.</strong> <%= t('You may change its department or status until an employee is assigned.') %></p></div>
<div class="admin-routing-actions"><form method="post" action="/admin/complaints/<%= complaint._id %>/assignment" class="review-action-form admin-forward-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Change department') %><select class="form-select mt-1" name="departmentId" required><option value=""><%= t('Choose a different department') %></option><% departments.filter(d => String(d._id) !== String(complaint.departmentId._id)).forEach(d => { %><option value="<%= d._id %>"><%= d.name %></option><% }); %></select></label><button class="btn btn-primary" type="submit" <%= departments.some(d => String(d._id) !== String(complaint.departmentId._id)) ? '' : 'disabled' %>><%- lucide('send') %><%= t('Update department') %></button></form>
<% if (['Submitted','Under Review','In Progress'].includes(complaint.status)) { %><form method="post" action="/admin/complaints/<%= complaint._id %>/status" class="review-action-form admin-forward-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Change complaint status') %><select class="form-select mt-1" name="status" required><% ['Under Review','In Progress','Rejected'].filter(status => status !== complaint.status).forEach(status => { %><option value="<%= status %>"><%= t(status) %></option><% }); %></select></label><label class="form-label"><%= t('Reason or update note') %><textarea class="form-control mt-1" name="remarks" rows="2" maxlength="2000" placeholder="<%= t('A reason is required when rejecting') %>"></textarea></label><button class="btn btn-outline-dark" type="submit"><%= t('Update status') %></button></form><% } %>
<form method="post" action="/admin/complaints/<%= complaint._id %>/assignment/remove" class="review-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p class="form-text"><%= t('Removing this department returns the report to Under Review for a fresh admin review.') %></p><button class="btn btn-outline-danger" type="submit"><%- lucide('remove_circle_outline') %><%= t('Remove department assignment') %></button></form></div>
<% } else if (complaint.departmentId) { %><div class="notice-panel admin-forwarded-note"><%- lucide('account_tree') %><p><strong><%= t('Forwarded to') %> <%= complaint.departmentId.name %>.</strong> <%= complaint.assignedEmployeeId ? t('An employee is assigned. Department and status changes are locked for administrators.') : t('The department team will assign an employee and handle this report.') %></p></div>
<% } else if (canForwardComplaint) { %><form method="post" action="/admin/complaints/<%= complaint._id %>/assignment" class="review-action-form admin-forward-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Department') %><select class="form-select mt-1" name="departmentId" required><option value=""><%= t('Choose a department') %></option><% departments.forEach(d => { %><option value="<%= d._id %>"><%= d.name %></option><% }); %></select></label><button class="btn btn-primary" type="submit" <%= departments.length ? "" : "disabled" %>><%- lucide('send') %><%= t('Forward to department') %></button></form>
<% } else { %><p class="text-muted"><%= t('This report is') %> <%= t(complaint.status) %>.</p><% } %></section>
<section class="content-card"><div class="section-heading"><div><h2><%= t("Activity timeline") %></h2><p>Accountability record for this report.</p></div></div><div class="timeline"><% events.forEach(event => { %><div class="timeline-item"><span class="timeline-icon"><%- lucide(event.type === 'status' ? 'sync_alt' : event.type === 'updated' ? 'edit_location_alt' : event.type === 'assignment' ? 'assignment_ind' : event.type === 'priority' ? 'priority_high' : event.type === 'message' ? 'chat' : 'add_location_alt') %></span><div><div class="timeline-title"><%= t(event.newStatus || event.type) %></div><p><%= event.remarks %></p><small><%= event.actorId?.fullName || 'System' %> · <%= event.createdAt.toLocaleString() %></small></div></div><% }); %></div></section>
</div><aside class="detail-aside"><section class="content-card"><h2 class="h6"><%= t("Set priority") %></h2><form method="post" action="/admin/complaints/<%= complaint._id %>/priority?_method=PATCH" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select" name="priority"><% priorities.forEach(p => { %><option value="<%= p %>" <%= complaint.priority === p ? 'selected' : '' %>><%= p %></option><% }); %></select><button class="btn btn-outline-dark btn-sm">Update priority</button></form><div class="meta-list mt-4"><div><small><%= t("RESIDENT") %></small><strong><%= complaint.citizenId?.fullName %></strong></div><div><small>LOCATION</small><strong><%= complaint.location.address %></strong></div><div><small>DEPARTMENT</small><strong><%= complaint.departmentId?.name || 'Unassigned' %></strong></div><div><small><%= t("ASSIGNED TO") %></small><strong><%= complaint.assignedEmployeeId?.fullName || 'Unassigned' %></strong></div></div></section><section class="content-card"><h2 class="h6"><%= t("Resident messages") %></h2><% if(messages.length) { messages.forEach(m => { %><div class="message-item"><strong><%= m.authorId?.fullName %></strong><small><%= m.createdAt.toLocaleString() %></small><p><%= m.body %></p></div><% }); } else { %><p class="text-muted"><%= t("No follow-up messages.") %></p><% } %></section></aside></div><%- include('../partials/page-bottom') %>






