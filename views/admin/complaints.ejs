<%- include('../partials/page-top') %><div class="page-heading"><div><p class="eyebrow">OPERATIONS CENTER</p><h1><%= t("Complaint queue") %></h1><p class="page-subtitle"><%= t("Review, prioritize, and route reports to the right team.") %></p></div><span class="queue-count"><%= complaints.length %> shown</span></div>
<section class="content-card"><form class="filter-bar filter-wrap" method="get"><input class="form-control search-input" name="q" value="<%= filters.q || '' %>" placeholder="<%= t('Search reports or locations') %>"><select class="form-select" name="status"><option value=""><%= t("All statuses") %></option><% statuses.forEach(s => { %><option value="<%= s %>" <%= s === filters.status ? 'selected' : '' %>><%= t(s) %></option><% }); %></select><select class="form-select" name="category"><option value=""><%= t("All categories") %></option><% categories.forEach(c => { %><option value="<%= c %>" <%= c === filters.category ? 'selected' : '' %>><%= t(c) %></option><% }); %></select><select class="form-select" name="priority"><option value=""><%= t("All priorities") %></option><% priorities.forEach(p => { %><option value="<%= p %>" <%= p === filters.priority ? 'selected' : '' %>><%= t(p) %></option><% }); %></select><input class="form-control date-filter" type="date" name="start" value="<%= filters.start || "" %>" aria-label="<%= t('Start date') %>"><input class="form-control date-filter" type="date" name="end" value="<%= filters.end || "" %>" aria-label="<%= t('End date') %>"><select class="form-select" name="sort"><option value="newest" <%= sortChoice === 'newest' ? 'selected' : '' %>><%= t('Newest first') %></option><option value="oldest" <%= sortChoice === 'oldest' ? 'selected' : '' %>><%= t('Oldest first') %></option><option value="priority" <%= sortChoice === 'priority' ? 'selected' : '' %>><%= t('Highest priority') %></option></select><select class="form-select" name="department"><option value=""><%= t('All departments') %></option><% departments.forEach(d => { %><option value="<%= d._id %>" <%= filters.department === String(d._id) ? 'selected' : '' %>><%= d.name %></option><% }); %></select><% if (filters.q || filters.status || filters.category || filters.priority || filters.department || filters.start || filters.end || sortChoice !== "newest") { %><a class="btn btn-primary admin-clear-filters" href="/admin/complaints"><%- lucide("close") %><%= t("Clear filters") %></a><% } else { %><button class="btn btn-primary" type="submit"><%= t("Apply filters") %></button><% } %></form><% if (complaints.length) { %><div class="table-responsive"><table class="table app-table"><thead><tr><th><%= t("REPORT") %></th><th><%= t("RESIDENT") %></th><th><%= t('DEPARTMENT / OWNER') %></th><th><%= t("PRIORITY") %></th><th><%= t("STATUS") %></th><th><%= t("UPDATED") %></th><th></th></tr></thead><tbody><% complaints.forEach(c => { %><tr><td><a class="table-title" href="/admin/complaints/<%= c._id %>"><%= c.title %></a><small><%= t(c.category) %> · <%= c.location.address %></small></td><td><%= c.citizenId?.fullName || t('Resident') %></td><td><%= c.departmentId?.name || '—' %><small><%= c.assignedEmployeeId?.fullName || t('Unassigned') %></small></td><td><span class="priority priority-<%= c.priority.toLowerCase() %>"><%= t(c.priority) %></span></td><td><%- include('../partials/status',{status:c.status}) %></td><td><%= c.updatedAt.toLocaleDateString(language) %></td><td><a class="report-view-button" href="/admin/complaints/<%= c._id %>" aria-label="<%= t('View complaint') %>"><%- lucide('visibility') %><span><%= t('View') %></span></a></td></tr><% }); %></tbody></table></div><% } else { %><%- include('../partials/empty',{icon:'search_off',title:'No reports found',description:'Try clearing one or more filters.'}) %><% } %><% if (pages > 1) { %><nav class="pagination-row"><span><%= t("Page") %> <%= page %> of <%= pages %></span><div><% if (page > 1) { %><a class="btn btn-sm btn-light" href="?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page-1 %>"><%= t("Previous") %></a><% } %> <% if (page < pages) { %><a class="btn btn-sm btn-light" href="?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page+1 %>"><%= t("Next") %></a><% } %></div></nav><% } %></section><%- include('../partials/page-bottom') %>





