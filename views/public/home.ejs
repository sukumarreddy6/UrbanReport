<!doctype html><html lang="<%= language %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>UrbanReport · Chennai civic reports</title><meta name="description" content="Report civic issues in Chennai, follow progress, and connect with local response teams."><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/site.css" rel="stylesheet"><link href="/css/experience.css" rel="stylesheet"><link href="/css/organization.css" rel="stylesheet"><link href="/css/homepage.css?v=role-auth-popup-switch-links-20261116" rel="stylesheet"></head><body class="civic-landing">
<header class="civic-header"><a class="civic-brand" href="/" aria-label="UrbanReport home"><%- lucide('location_city') %><span>UrbanReport</span></a><div class="civic-header-actions"><%- include('../partials/language-switch') %><nav class="civic-role-nav" aria-label="Portal navigation"><details class="civic-user-menu"><summary><%- lucide('person') %><span class="user-label">USER</span><span class="user-menu-chevron" aria-hidden="true"></span></summary><div class="civic-user-dropdown"><a href="/login?portal=user" data-home-auth="login" data-home-portal="user">Sign in</a><a href="/register" data-home-auth="register">Sign up</a></div></details><a href="/login?portal=admin" data-home-auth="login" data-home-portal="admin"><%- lucide('shield') %><span>ADMIN</span></a><a href="/login?portal=department" data-home-auth="login" data-home-portal="department"><%- lucide('account_tree') %><span>DEPARTMENT</span></a><a href="/login?portal=employee" data-home-auth="login" data-home-portal="employee"><%- lucide('assignment_ind') %><span>EMPLOYEE</span></a></nav></div></header>
<div class="home-auth-backdrop" data-home-auth-backdrop hidden><section class="home-auth-window" role="dialog" aria-modal="true" aria-labelledby="home-auth-title"><button type="button" class="home-auth-close" data-home-auth-close aria-label="Close">×</button><div class="home-auth-panel" data-home-auth-panel="login"><p class="home-auth-eyebrow" data-home-auth-eyebrow>CITIZEN PORTAL</p><h2 id="home-auth-title" data-home-auth-title>Welcome back</h2><p class="home-auth-intro" data-home-auth-intro>Sign in to follow your reports and updates.</p><form method="post" action="/login" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="portal" value="user" data-home-auth-portal><label class="form-label">Email address<input class="form-control mt-1" type="email" name="email" required autocomplete="email" placeholder="you@example.com"></label><label class="form-label">Password<input class="form-control mt-1" type="password" name="password" required autocomplete="current-password" placeholder="Your password"></label><a class="home-auth-forgot" href="/forgot-password">Forgot password?</a><button class="btn btn-primary w-100" type="submit">Sign in</button></form><p class="home-auth-switch">New to UrbanReport? <button type="button" data-home-auth-switch="register">Create an account</button></p></div><div class="home-auth-panel" data-home-auth-panel="register" hidden><p class="home-auth-eyebrow">CITIZEN PORTAL</p><h2>Create your account</h2><p class="home-auth-intro">Register to report an issue and track its progress.</p><form method="post" action="/register" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Full name<input class="form-control mt-1" name="fullName" required minlength="2" maxlength="100" autocomplete="name" placeholder="Your full name"></label><label class="form-label">Email address<div class="email-verification-row mt-1"><input id="home-registration-email" class="form-control" type="email" name="email" required autocomplete="email" placeholder="you@example.com"><button id="home-send-email-code" class="btn btn-outline-dark" type="button">Send code</button></div></label><p id="home-otp-status" class="form-text otp-status" role="status" aria-live="polite">Verify your email before creating your account.</p><label class="form-label">Email verification code<input class="form-control mt-1" name="otp" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="123456"></label><label class="form-label">Password<input class="form-control mt-1" type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password" placeholder="At least 12 characters"></label><button class="btn btn-primary w-100" type="submit">Create account</button></form><p class="home-auth-switch">Already registered? <button type="button" data-home-auth-switch="login">Sign in</button></p></div></section></div>
<main class="home-screen">
  <section class="gcc-feature" aria-label="Greater Chennai Corporation headquarters">
    <img src="/images/landmarks/ripon-building.jpg" alt="Ripon Building, headquarters of the Greater Chennai Corporation" fetchpriority="high">
  </section>  <section class="chennai-stats-strip" aria-label="Greater Chennai Corporation facts">
    <article class="chennai-stat-card"><%- lucide('map') %><span>Area</span><strong>426 <small>sq km</small></strong></article>
    <article class="chennai-stat-card"><%- lucide('building_2') %><span>Civic body</span><strong>Greater Chennai<br>Corporation</strong></article>
    <article class="chennai-stat-card"><%- lucide('account_tree') %><span>Administrative zones</span><strong>15</strong></article>
    <article class="chennai-stat-card"><%- lucide('dashboard') %><span>Wards</span><strong>200</strong></article>
    <article class="chennai-stat-card"><%- lucide('groups') %><span>Estimated population <small>2025</small></span><strong>92.8 lakh</strong></article>
    <article class="chennai-stat-card"><%- lucide('calendar') %><span>Corporation established</span><strong>1688</strong></article>
    <article class="chennai-stat-card"><%- lucide('road') %><span>Road network</span><strong>7,302 <small>km</small></strong></article>
  </section>
  <section class="important-person-carousel" data-political-carousel aria-label="Tamil Nadu public leadership">
    <div class="important-person-photo-window"><div class="important-person-photo-track" data-political-track>
      <article class="important-person-photo is-active" data-political-slide aria-hidden="false"><img src="/images/leaders/tamil-nadu-governor.jpg" alt="Tamil Nadu Governor Rajendra Vishwanath Arlekar" loading="eager"></article>
      <article class="important-person-photo" data-political-slide aria-hidden="true"><img src="/images/leaders/tamil-nadu-chief-minister.jpg" alt="Tamil Nadu Chief Minister C. Joseph Vijay" loading="lazy"></article>
      <article class="important-person-photo" data-political-slide aria-hidden="true"><img src="/images/leaders/lok-sabha-speaker.jpg" alt="Lok Sabha Speaker Om Birla" loading="lazy"></article>
    </div></div>
    <div class="important-person-copy-window"><div class="important-person-copy-track" data-political-copy-track>
      <article class="important-person-copy is-active" data-political-copy-slide aria-hidden="false"><span>Governor of Tamil Nadu</span><h2>Thiru Rajendra Vishwanath Arlekar</h2><p>He assumed office as Tamil Nadu’s Governor on 12 March 2026. Earlier, he served as Governor of Himachal Pradesh and Bihar, and as Speaker of the Goa Legislative Assembly, where he led work toward a paperless Assembly. As Governor, he carries out the constitutional responsibilities of the office and works with the elected state government.</p><a href="https://lokbhavan.tn.gov.in/governors-profile/" target="_blank" rel="noopener">Official profile <%- lucide('arrow_outward') %></a></article>
      <article class="important-person-copy" data-political-copy-slide aria-hidden="true"><span>Chief Minister of Tamil Nadu</span><h2>Thiru C. Joseph Vijay</h2><p>He took office as Chief Minister on 10 May 2026. The Chief Minister leads the elected state government and chairs the Council of Ministers, coordinating the work of Tamil Nadu’s departments and setting the government’s priorities. The office is central to turning public policy into services for people across the state.</p><a href="https://lokbhavan.tn.gov.in/gallery/thiru-c-joseph-vijay-was-sworn-in-as-chief-minister-of-tamil-nadu-thiru-rajendra-vishwanath-arlekar-honble-governor-of-tn-administered-the-oath-of-office-to-thiru-c-joseph-vijay-10-05-2026/" target="_blank" rel="noopener">Official profile <%- lucide('arrow_outward') %></a></article>
      <article class="important-person-copy" data-political-copy-slide aria-hidden="true"><span>Speaker of the Lok Sabha</span><h2>Shri Om Birla</h2><p>First elected Speaker of the 17th Lok Sabha, he was chosen again for the 18th Lok Sabha in June 2024. He presides over House sittings, applies parliamentary procedure, and helps members participate in orderly debate. The Speaker’s office is responsible for protecting the dignity and functioning of the House.</p><a href="https://sansad.in/ls/about/speaker" target="_blank" rel="noopener">Official profile <%- lucide('arrow_outward') %></a></article>
    </div></div>
    <div class="important-person-controls"><div class="important-person-dots" role="group" aria-label="Choose a leader"><button type="button" class="is-active" data-political-dot="0" aria-label="Show Tamil Nadu Governor" aria-current="true"></button><button type="button" data-political-dot="1" aria-label="Show Tamil Nadu Chief Minister"></button><button type="button" data-political-dot="2" aria-label="Show Lok Sabha Speaker"></button></div><div class="important-person-arrows"><button type="button" data-political-prev aria-label="Previous leader">‹</button><button type="button" data-political-pause aria-label="Pause leaders" aria-pressed="false">Ⅱ</button><button type="button" data-political-next aria-label="Next leader">›</button></div></div>
  </section>
  <section class="chennai-community-grid" aria-label="Chennai civic information">
    <section id="helplines" class="chennai-info-card" aria-labelledby="helplines-title"><div class="chennai-info-heading"><div><p class="home-intro-kicker">HELP WHEN YOU NEED IT</p><h2 id="helplines-title">Chennai helplines</h2></div><%- lucide('phone') %></div><div class="chennai-helpline-grid">
      <a class="chennai-helpline" href="tel:1913"><span class="helpline-icon"><%- lucide('building_2') %></span><span class="helpline-label">Corporation complaints</span><strong>1913</strong></a>
      <a class="chennai-helpline" href="tel:1077"><span class="helpline-icon"><%- lucide('life_buoy') %></span><span class="helpline-label">Collectorate control room</span><strong>1077</strong></a>
      <a class="chennai-helpline" href="tel:100"><span class="helpline-icon"><%- lucide('shield') %></span><span class="helpline-label">Police</span><strong>100</strong></a>
      <a class="chennai-helpline" href="tel:101"><span class="helpline-icon"><%- lucide('flame') %></span><span class="helpline-label">Fire &amp; rescue</span><strong>101</strong></a>
      <a class="chennai-helpline" href="tel:108"><span class="helpline-icon"><%- lucide('ambulance') %></span><span class="helpline-label">Accident / ambulance</span><strong>108</strong></a>
      <a class="chennai-helpline" href="tel:181"><span class="helpline-icon"><%- lucide('heart_handshake') %></span><span class="helpline-label">Women helpline</span><strong>181</strong></a>
      <a class="chennai-helpline" href="tel:1098"><span class="helpline-icon"><%- lucide('baby') %></span><span class="helpline-label">Child helpline</span><strong>1098</strong></a>
      <a class="chennai-helpline" href="tel:1070"><span class="helpline-icon"><%- lucide('siren') %></span><span class="helpline-label">State control room</span><strong>1070</strong></a>
    </div><p class="chennai-source-note">Helpline numbers listed by <a href="https://chennai.nic.in/helpline/" target="_blank" rel="noopener">Chennai District</a>.</p></section>

    <section class="chennai-city-map" aria-label="Tamil Nadu map image"><img src="/images/tamil-nadu-silhouette.png" alt="Illustrated map silhouette of Tamil Nadu with its name and a temple drawing" loading="lazy"></section>
  </section>

  <footer class="chennai-home-footer"><span>UrbanReport Chennai</span><span>Community reporting platform · Not an official government website</span><a href="https://chennai.nic.in/" target="_blank" rel="noopener">Chennai District portal <%- lucide('arrow_outward') %></a></footer>
</main>
<script src="/js/home-motion.js" defer></script><script src="/js/political-carousel.js" defer></script><script src="/js/home-auth.js?v=role-auth-switch-20261116" defer></script><script src="/js/register-otp.js" defer></script><script src="/js/bootstrap-validation.js" defer></script>
</body></html>
