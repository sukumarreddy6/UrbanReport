<!doctype html>
<html lang="<%= language %>">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t(title) %> · UrbanReport</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/site.css" rel="stylesheet"><link href="/css/experience.css" rel="stylesheet"><link href="/css/organization.css" rel="stylesheet">
</head>
<body class="not-found-page">
  <header class="not-found-header"><a href="/" class="not-found-brand"><%- lucide('location_city') %><span>UrbanReport</span></a></header>
  <main class="not-found-main">
    <section class="not-found-card" aria-labelledby="not-found-title">
      <span class="not-found-code">404</span>
      <div class="not-found-icon"><%- lucide('search_off') %></div>
      <h1 id="not-found-title"><%= t(title) %></h1>
      <p><%= t(message) %></p>
      <a href="/" class="btn btn-primary"><%- lucide('home') %><%= t('Return home') %></a>
    </section>
  </main>
</body>
</html>
