<%- include('../partials/page-top') %><div class="page-heading"><div><a class="back-link" href="/employee/complaints"><%- lucide('arrow_back') %> <%= t("Assigned reports") %></a><p class="eyebrow mt-3">YOUR ASSIGNMENT · <%= String(complaint._id).slice(-8).toUpperCase() %></p><h1><%= complaint.title %></h1><p class="page-subtitle"><%= t(complaint.category) %> · <%= complaint.location.address %></p></div><%- include('../partials/status',{status:complaint.status}) %></div><div class="detail-grid"><div class="detail-main"><section class="content-card"><div class="section-heading"><div><h2><%= t("Issue details") %></h2><p><%= t("Reported by") %> <%= complaint.citizenId?.fullName %></p></div><span class="priority priority-<%= complaint.priority.toLowerCase() %>"><%= t(complaint.priority) %> <%= t('priority') %></span></div><p class="detail-description"><%= complaint.description %></p><% if (complaint.images.length) { %><div class="image-grid"><% complaint.images.forEach(image => { %><a href="<%= image.displayUrl %>" target="_blank" rel="noopener"><img src="<%= image.displayUrl %>" alt="Complaint photo"></a><% }); %></div><% } %><% if (complaint.resolutionImages?.length) { %><div class="mt-4"><h3 class="h6"><%= t('Proof of work') %></h3><div class="image-grid"><% complaint.resolutionImages.forEach(image => { %><a href="<%= image.displayUrl %>" target="_blank" rel="noopener"><img src="<%= image.displayUrl %>" alt="<%= t('Employee proof of completed work') %>"></a><% }); %></div></div><% } %><div class="info-strip"><%- lucide('location_on') %><div><small>LOCATION</small><strong><%= complaint.location.address %></strong></div></div></section><section class="content-card"><div class="section-heading"><div><h2><%= t("Work update") %></h2><p><%= t("Keep your progress and resolution notes clear.") %></p></div></div><% if (complaint.status === 'Assigned') { %><form method="post" action="/employee/complaints/<%= complaint._id %>/status?_method=PATCH"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="In Progress"><input type="hidden" name="remarks" value="Work started."><button class="btn btn-primary"><%- lucide('play_arrow') %> <%= t("Accept and start work") %></button></form><% } else if (complaint.status === 'In Progress') { %><form method="post" action="/employee/complaints/<%= complaint._id %>/withdraw" class="mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger" type="submit"><%- lucide('undo') %><%= t('Withdraw from work') %></button></form><form method="post" enctype="multipart/form-data" action="/employee/complaints/<%= complaint._id %>/status?_method=PATCH" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="Resolved"><label class="form-label"><%= t("Resolution details") %><textarea class="form-control" name="remarks" rows="4" required minlength="5" maxlength="2000" placeholder="Describe the repair or action completed"></textarea></label><label class="form-label"><%= t("Proof-of-work photos") %><input class="form-control mt-1" type="file" name="proofImages" accept="image/jpeg,image/png,image/webp,image/avif" multiple required data-proof-images><span class="form-text"><%= t("Upload at least one photo showing the completed work. Up to five JPG, PNG, WebP, or AVIF images, 5 MB each.") %></span></label><div class="image-preview-grid" data-proof-preview></div><button class="btn btn-primary align-self-start"><%- lucide('task_alt') %> <%= t("Submit proof and request confirmation") %></button></form><% } else if (complaint.status === 'Awaiting User Confirmation') { %><div class="notice-panel mb-3"><%- lucide('schedule') %><p><%= t('The resident has not confirmed the resolution yet. You may withdraw your request and return the report to In Progress.') %></p></div><form method="post" action="/employee/complaints/<%= complaint._id %>/resolution/withdraw"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger" type="submit"><%- lucide('undo') %><%= t('Withdraw resolution request') %></button></form><% } else if (complaint.status === 'Reopened') { %><div class="notice-panel"><%- lucide('info') %><p><%= t("This report was reopened. An administrator will confirm or update its assignment before you continue.") %></p></div><% } else { %><div class="notice-panel"><%- lucide('check_circle') %><p>Current status: <strong><%= t(complaint.status) %></strong></p></div><% } %></section><section class="content-card"><div class="section-heading"><div><h2><%= t("Timeline") %></h2><p><%= t("Report and work history") %></p></div></div><div class="timeline"><% events.forEach(event => { %><div class="timeline-item"><span class="timeline-icon"><%- lucide('sync_alt') %></span><div><div class="timeline-title"><%= t(event.newStatus || event.type) %></div><p><%= event.remarks %></p><small><%= event.actorId?.fullName || 'System' %> · <%= event.createdAt.toLocaleString() %></small></div></div><% }); %></div></section></div><aside class="detail-aside"><section class="content-card"><h2 class="h6"><%= t("Report summary") %></h2><div class="meta-list"><div><small><%= t("STATUS") %></small><%- include('../partials/status',{status:complaint.status}) %></div><div><small><%= t("PRIORITY") %></small><strong><%= complaint.priority %></strong></div><div><small>DEPARTMENT</small><strong><%= complaint.departmentId?.name %></strong></div><div><small>REPORTED</small><strong><%= complaint.createdAt.toLocaleDateString() %></strong></div></div></section><section class="content-card"><h2 class="h6"><%= t("Resident updates") %></h2><% if(messages.length) { messages.forEach(m => { %><div class="message-item"><strong><%= m.authorId?.fullName %></strong><small><%= m.createdAt.toLocaleString() %></small><p><%= m.body %></p></div><% }); } else { %><p class="text-muted"><%= t("No additional details yet.") %></p><% } %></section></aside></div><script src="/js/proof-preview.js" defer></script>
<%- include('../partials/page-bottom') %>





