<%- include('../partials/page-top') %><div class="page-heading"><div><p class="eyebrow"><%= t('Field workspace') %></p><h1><%= t('Assigned reports') %></h1><p class="page-subtitle"><%= t('Only reports assigned directly to you are shown here.') %></p></div></div><section class="content-card"><form class="filter-bar" method="get"><select class="form-select" name="status"><option value=""><%= t('All statuses') %></option><% ['Assigned','In Progress','Awaiting User Confirmation','Resolved','Reopened'].forEach(s => { %><option value="<%= s %>" <%= s === selectedStatus ? 'selected' : '' %>><%= t(s) %></option><% }); %></select><button class="btn btn-outline-secondary"><%= t('Filter') %></button></form><% if (complaints.length) { %><div class="table-responsive"><table class="table app-table"><thead><tr><th><%= t('REPORT') %></th><th><%= t('LOCATION') %></th><th><%= t('PRIORITY') %></th><th><%= t('STATUS') %></th><th></th></tr></thead><tbody><% complaints.forEach(c => { %><tr><td><a class="table-title" href="/employee/complaints/<%= c._id %>"><%= c.title %></a><small><%= t(c.category) %> · <%= c.departmentId?.name || '' %></small></td><td><%= c.location.address %></td><td><span class="priority priority-<%= c.priority.toLowerCase() %>"><%= t(c.priority) %></span></td><td><%- include('../partials/status',{status:c.status}) %></td><td><a class="report-view-button" href="/employee/complaints/<%= c._id %>" aria-label="<%= t('View complaint') %>"><%- lucide('visibility') %><span><%= t('View') %></span></a></td></tr><% }); %></tbody></table></div><% } else { %><%- include('../partials/empty',{icon:'task_alt',title:'Nothing in this view',description:'Try another status or check back after your administrator assigns work.'}) %><% } %></section><%- include('../partials/page-bottom') %>




